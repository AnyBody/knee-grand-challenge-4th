//       };//Knee
//       #endif
      #endif
      
      #if (BM_JOINT_TYPE_PATELLOFEMORAL_RIGHT == _JOINT_TYPE_USERDEFINED_)
      AnyRevoluteJoint PatellaFemur = 
      {
        Axis = z;
        AnyRefNode &ThighNode = ..Segments.Thigh.PatellaFemurJoint;
        AnyRefNode &PatellaNode = ..Segments.Patella.PatellaFemurJoint;
      };//Patellafemur
      #endif
      
      #if (BM_JOINT_TYPE_ANKLE_RIGHT == _JOINT_TYPE_USERDEFINED_)
      AnyRevoluteJoint Ankle = 
      {
        Axis = z; //flexion extension
        AnyRefNode &ShankNode = ..Segments.Shank.AnkleJoint;
        AnyRefNode &FootNode  = ..Segments.Talus.AnkleJoint;
      };//Ankle
      #endif
      
