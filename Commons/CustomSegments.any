HumanModel.BodyModel =
{
  #if BM_LEG_RIGHT == ON
  Right.Leg =
  {
    Joints = 
    {
      #if (BM_JOINT_TYPE_HIP_RIGHT == _JOINT_TYPE_USERDEFINED_)
      AnySphericalJoint Hip = 
      {
        AnyRefNode &ThighNode = ..Segments.Thigh.HipJoint;
        AnyRefNode &PelvisNode = ..Segments.Pelvis.HipJoint;
      };//Hip
      #endif
      
            
      #if (BM_JOINT_TYPE_KNEE_RIGHT == _JOINT_TYPE_USERDEFINED_)
//       #if KNEE_JOINT_TYPE == __SPHERICAL__
       
        AnySphericalJoint Knee = {
          AnyRefNode &ThighNode = ..Segments.Thigh.KneeJoint;
          AnyRefNode &ShankNode = ..Segments.Shank.KneeJoint;
        };
        AnyKinRotational KneeRot = {
          AnyRefNode &ThighNode = ..Segments.Thigh.KneeJoint;
          AnyRefNode &ShankNode = ..Segments.Shank.KneeJoint;
          Type = PlanarAngles;
        };
        AnyKinEqSimpleDriver KneeRotations = {
          DriverPos = {0,0};
          DriverVel = {0,0};
          AnyKinMeasure &Measure = .KneeMoments.org;
          CType = {Soft, Soft};
          Reaction.Type = {Off, Off};
          WeightFun = {&wFun, &wFun};
          AnyFunConst wFun = {Value = {1e-3};};
        };
        AnyReacForce KneeMoments = {
          AnyKinMeasureOrg org = {
            AnyKinMeasure &KneeRot = ..KneeRot;
            MeasureOrganizer = {1,2};
          };
        };
//     #else   
