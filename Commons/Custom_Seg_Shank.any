PatientNode = {
  
  JOINT_FITTING_DATA_SHANK FittingData() = {};
  
  //fit ankle here: todo
  AnySurfEllipsoidFit AnkleJointFit = {    
    Spherical = On;
    Points = .FittingData.AnkleJointPoints;//will use morphed femoral head as input
    AnyDrawRefFrame DrawAnkleJointTibia= {ScaleXYZ={1,1,1}*0.1;RGB={1,1,0};};
    
  };
  
  AnyFunTransform3DLin ThighToShankReg = {
    ScaleMat ??= eye(3);
    Offset ??= {0,0,0};
  };
  AnyRefNode KneeJoint = {
    sRel = .ThighToShankReg(...Thigh.PatientNode.KneeJointFit.sRel);
    ARel = RotMat(
      .ThighToShankReg({0.0,0.0,0.0}),
      .ThighToShankReg({1.0,0.0,0.0}),
      .ThighToShankReg({0.0,1.0,0.0})
      )*...Thigh.PatientNode.ARel'*...Thigh.KneeJointNew.ARel; // fitted and aligned axes
  };

  AnyRefNode KneeJointConstructed = {
    sRel = .ThighToShankReg(...Thigh.PatientNode.KneeJointConstructed.sRel);
    ARel = RotMat(
      .ThighToShankReg({0.0,0.0,0.0}),
      .ThighToShankReg({1.0,0.0,0.0}),
      .ThighToShankReg({0.0,1.0,0.0})
      )*...Thigh.PatientNode.KneeJointConstructed.ARel; // fitted and aligned axes
  };
  
};// automatically created


AnyRefNode KneeJointNew = {
  sRel = .PatientNode.sRel + .PatientNode.KneeJoint.sRel * .PatientNode.ARel';
  ARel = .PatientNode.ARel * .PatientNode.KneeJoint.ARel;
  //AnyDrawRefFrame DrawKneeJointTibia= {ScaleXYZ={1,1,1}*0.1;RGB={1,0,0};};
};  

