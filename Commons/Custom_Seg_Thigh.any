PatientNode = {
  
  //AnyDrawRefFrame PatientNode = {ScaleXYZ={1,1,1}*0.1;RGB={1,1,0.2};};
  
  JOINT_FITTING_DATA_THIGH FittingData() = {};
  
  //fit cylinders to find a knee joint node
  AnySurfCylinderFit KneeJointFit = {    
    Length = 0.0;
    Points = .FittingData.KneeJointPoints;//will use morphed condyles by default?!
    CenterOrigin=On;
    //AnyDrawParamSurf draw={};
    //AnyDrawRefFrame DrawKneeJointFem = {ScaleXYZ={1,1,1}*0.1;RGB={1,0,0};};
  };
  
  //fit cylinders to find a PF joint node
  AnySurfCylinderFit PatellaFemoralJointFit = {    
    Length = 0.0;
    Points = .FittingData.PFJointPoints;//will use morphed condyles by default?!
    //AnyDrawParamSurf draw={};
    Direction = {1,0,0};
    FixedDirection = On;
    CenterOrigin=On;
  };
    
  //fit sphere to find a hip joint node, orientation
  AnySurfEllipsoidFit HipJointFit = {    
    Spherical = On;
    Points = .FittingData.HipJointPoints;//will use morphed femoral head as input
    //AnyDrawRefFrame DrawHipJointFem = {ScaleXYZ={1,1,1}*0.1;RGB={1,0,0};};
  };
};// automatically created

AnyRefNode HipJointNew = 
{
  sRel = .PatientNode.sRel + .PatientNode.HipJointFit.sRel * .PatientNode.ARel';
    
  //  Y-axis: Along the femoral shaft, from knee joint center to hip joint center
  //  X-axis: Perpendicular to the plane formed by the hip joint center and the medial and lateral epicondyles
  //  Z-axis: Orthogonal to X and Y  

  ARel = RotMat(  
    {0.0, 0.0, 0.0}, 
    cross(sRel-.EpicondylusFemorisMedialis.sRel, sRel-.EpicondylusFemorisLateralis.sRel), 
    sRel - .KneeJointNew.sRel
    );
  AnyDrawRefFrame DrawHipJointFem = {ScaleXYZ={1,1,1}*0.1;RGB={1,0,0};};
};

AnyRefNode KneeJointNew = 
{
  sRel = .PatientNode.sRel + .PatientNode.KneeJointFit.sRel * .PatientNode.ARel';
  
  // Following this logic, but using the fitted axis
  
  //1. X-axis (medial-lateral axis)
  //Points from the medial epicondyle to the lateral epicondyle.
  //This axis defines the flexion-extension axis of the knee.
  //2. Y-axis (proximal-distal axis)
  //Points from the knee joint center to the hip joint center (femoral shaft direction).
  //This axis is often called the long axis of the femur and points proximally.
  //3. Z-axis (anterior-posterior axis)
  //Computed as the cross product of X and Y (Z = X × Y).
  //Points anteriorly, completing a right-handed coordinate system.
  
  ARel = RotMat(
    {0.0, 0.0, 0.0}, 
    {0,0, 1} *.PatientNode.KneeJointFit.ARel'*.PatientNode.ARel',
    .HipJointNew.sRel - sRel
    ) 
    * RotMat(pi/2, y)                 // for better consistency with ABT's implementation
    * RotMat(VarusValgusRotation, x)  // custom varus-valgus angle
  ;
  //AnyDrawRefFrame DrawKneeJointFem = {ScaleXYZ={1,1,1}*0.1;RGB={1,0,0};};
  AnyVar VarusValgusRotation = DesignVar(0);
};

AnyRefNode PatellaFemurJointNew = 
{
  sRel = .PatientNode.sRel + .PatientNode.PatellaFemoralJointFit.sRel * .PatientNode.ARel';
  ARel = RotMat(
    {0.0, 0.0, 0.0}, 
    {0,0, 1} *.PatientNode.PatellaFemoralJointFit.ARel'*.PatientNode.ARel',
    .HipJointNew.sRel - .KneeJointNew.sRel
    ) 
    * RotMat(-pi/2, y)
    ;                 // for better consistency with ABT's implementation
    
  AnyDrawRefFrame DrawPFJointFem = {ScaleXYZ={1,1,1}*0.1;RGB={0,0,1};};
    
};

#if (BM_JOINT_TYPE_HIP_RIGHT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == 1) | (BM_JOINT_TYPE_HIP_LEFT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == -1)
AnyRefNode& HipJoint = HipJointNew;
#endif

#if (BM_JOINT_TYPE_KNEE_RIGHT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == 1) | (BM_JOINT_TYPE_KNEE_LEFT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == -1)
AnyRefNode& KneeJoint = KneeJointNew;
#endif

#if (BM_JOINT_TYPE_PATELLOFEMORAL_RIGHT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == 1) | (BM_JOINT_TYPE_PATELLOFEMORAL_LEFT == _JOINT_TYPE_USERDEFINED_ & SEG_SIGN == -1)
AnyRefNode &PatellaFemurJoint = PatellaFemurJointNew; 
#endif

