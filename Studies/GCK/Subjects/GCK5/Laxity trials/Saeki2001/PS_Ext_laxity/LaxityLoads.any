AnyFolder &RefShank =Main.Studies.HumanModel.BodyModel.Left.Leg.Seg.Shank;
RefShank={
  AnyRefNode IntExtLoadNode = {
    sRel = .AnatomicalFrameBL.sRel;
    ARel = .AnatomicalFrameBL.ARel;
    AnyDrawRefFrame dDraw ={}; 
    // DEF_REFNODE_CUSTOM_SCALING_1arg(sRel_pippo)
  };
};

AnyFolder LaxityLoads = {
  
  AnyFloatVar LaxityLoad = 1.5; //Nm
  
  #ifdef APPLY_COMPRESSIVE_LOAD
  AnyForce3D CompressiveLoad = {
    AnyRefFrame &CompPoint =..RefShank.AnatomicalFrameBL;
    //  AnyRefFrame &AnteriorPoint =Main.Studies.InverseDinamicStudy.ModelEnvironmentConnection.InternalLoadNode;
    Flocal={0,APPLY_COMPRESSIVE_LOAD,0}; //N
    AnyDrawForce draw={AppliedForceColor  = {1,0,0};};
  };
  #endif
  
  //positive: external, negative: internal
  AnyMoment3D IntExtLoad = {
    AnyRefFrame &Point =..RefShank.IntExtLoadNode;
    //  AnyRefFrame &AnteriorPoint =Main.Studies.InverseDinamicStudy.ModelEnvironmentConnection.InternalLoadNode;
    Mlocal={0,t*.LaxityLoad/Main.Studies.InverseDynamicStudy.tEnd,0}; //N*m
    AnyDrawForce draw={AppliedForceColor  = {0,0,1};};
  };
};