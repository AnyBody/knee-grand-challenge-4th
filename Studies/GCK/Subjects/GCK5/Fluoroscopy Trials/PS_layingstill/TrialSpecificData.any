#path TRIAL_PATH "."
AnyFolder TrialSpecificData = {
  
  #define FLUOROSCOPY_DRIVERS_TYPE 0
  
  #ifndef NO_MARKER_DRIVERS
   #define NO_MARKER_DRIVERS
  #endif
  
//  #ifndef TRIAL_SPECIFIC_FDK_INITIAL_CONDITIONS
//   #define TRIAL_SPECIFIC_FDK_INITIAL_CONDITIONS
//  #endif
  
  #define STATIC_DRIVERSET 0
  
  #define EXCLUDE_FORCEPLATES   
   
  // Name of the kinematic data file to be analysed
  AnyString TrialName = ANYBODY_NAME_MAINFILEDIR; //Trialname specifies naming of output files
  
  // initial position of knee joint measures
  AnyVector TibiaFemoralFDKInitPos = {0.0, 0.0, 0}; //x,y,z translations
  AnyVector TibiaFemoralFDKInitRot = {0.0, 0.0}; //y,x rotations
  
  AnyVector PatellaFemurFDKInitRot = {0}; // initial patella flexion
  
  AnyFolder DrvInitPos = { // deg
    AnyVar KneeFlexion              =  (  0.0);
    AnyVar HipFlexion               =  (  0.0);
    AnyVar HipAbduction             =  (  0.0);
    AnyVar HipExternalRotation      =  (  0.0);
  };
  AnyFolder DrvInitVel = { // deg/s
    AnyVar KneeFlexion              =  (  0.0)*180/pi;
  };
  
  // ********** Time ***********
  // change these according to your fluoroscopy data!
  AnyIntVar nFrames = 1;
  AnyFloatVar FluoroFrameRate = 30/3;
  // FirstFrameOffset is the offset value from the first frame of track file
  AnyIntVar FirstFrameOffset = 0;
  // LastFrameOffset is the offset value from the last frame of track file
  AnyIntVar LastFrameOffset  = 0;
  // Number of steps for the analysis but can be changed is needed
  AnyIntVar nStep = Main.ModelSetup.nStep + 1;
  
  // ********** Gravity ***********
  // Gravity vector that is consistent with the laboratory setting
  AnyVector Gravity = {-9.82,0,0}; // Z direction is normal to the ground
  
  //This is the initial position of the body it should only be touched it the kinematics does not work it first timestep
  //then these variable can be used to create a better guess, otherwise leave them unchanged
  AnyFolder InitialPositionOfBody ={
    
    // Initial Pelvis rotation. Rotation is calculated automatically if
    // the PelvisRotMat is defined.
    AnyVar PelvisRotZ = 0;
    AnyVar PelvisRotY = -10;
    AnyVar PelvisRotX = 90;
    
    AnyVar PelvisThoraxExtension = -20;
    AnyVar PelvisThoraxLateralBending=0;  
    AnyVar PelvisThoraxRotation=0;    
    
    AnyVar NeckExtension=0;     
    
    AnyFolder Right= {
      AnyVar HipFlexion                   =  0;
      AnyVar HipAbduction                 =  0;
      AnyVar HipExternalRotation          =  5;
      AnyVar KneeFlexion                  =  0;
      AnyVar AnklePlantarFlexion          =  0;
      AnyVar SubTalarEversion             =  0;
      AnyVar GlenohumeralFlexion          = 20; 
      AnyVar GlenohumeralAbduction        = 30; 
      AnyVar GlenohumeralExternalRotation = 00; 
      AnyVar ElbowFlexion                 = 90; 
      AnyVar ElbowPronation               =-60;
      AnyVar WristFlexion                 =  0;
      AnyVar WristAbduction               =  0;
    };
    
    AnyFolder Left = {
      AnyVar HipFlexion                   =  0;
      AnyVar HipAbduction                 =  0;
      AnyVar HipExternalRotation          =  0;
      AnyVar KneeFlexion                  =  0;
      AnyVar AnklePlantarFlexion          =  0;
      AnyVar SubTalarEversion             =  0;
      AnyVar GlenohumeralFlexion          = 20; 
      AnyVar GlenohumeralAbduction        = 30;
      AnyVar GlenohumeralExternalRotation =  0;
      AnyVar ElbowFlexion                 = 90; 
      AnyVar ElbowPronation               =-60;       
      AnyVar WristFlexion                 =  0;
      AnyVar WristAbduction               =  0;
    };
  };
   
};