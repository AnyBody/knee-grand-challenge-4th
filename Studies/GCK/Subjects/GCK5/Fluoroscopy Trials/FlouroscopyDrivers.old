Main.Studies.HumanModel.BodyModel.Left.Leg.Seg.Thigh = {
  AnyRefNode FluoroFrame = {
    AnyVar FemCompEdgeAngle = -40;
    AnyVec3 sRel_us = {0.029,0.022,0};
    //    AnyVec3 sRel_us = {0.012,-0.02,0}; //for ARel alignment
    AnyMat33 ARel_us = RotMat(FemCompEdgeAngle*pi/180,z);
    DEF_REFNODE_CUSTOM_SCALING_2arg(sRel_us,ARel_us)
    AnyRefNode FluoroFrame2 = {
      ARel= RotMat((-.FemCompEdgeAngle + 4)*pi/180, z);
      AnyDrawRefFrame drw2={ScaleXYZ=0.025*{1,1,1}; RGB={51,102,153}/255;};
    };
    
  };
};

Main.Studies.HumanModel.BodyModel.Left.Leg.Seg.Shank = {
  AnyRefNode FluoroFrame = {
    AnyVec3 sRel_us = {0.019,0.003,0};
    AnyMat33 ARel_us= RotMat(1*pi/180,z);
    DEF_REFNODE_CUSTOM_SCALING_2arg(sRel_us,ARel_us)
    AnyDrawRefFrame drw2={ScaleXYZ=0.025*{1,1,1}; RGB={255,51,51}/255;};
  };
};

Main.Studies.HumanModel.BodyModel.Left.Leg.Seg.Patella = {
  AnatomicalFrameBL = {
    AnyRefNode FluoroFrame = {
      sRel= {-0.002,0,0};
      AnyDrawRefFrame drw2={ScaleXYZ=0.025*{1,1,1}; RGB={102,204,51}/255;};
    };
  };
};

