#path TRIAL_PATH "."
AnyFolder TrialSpecificData={
  
  // Link between forceplates and feet
  #define FootOnForcePlate1 .BodyModelRef.Left.Leg.Seg.Foot
  #define FootOnForcePlate2 .BodyModelRef.Right.Leg.Seg.Foot
  #define FootOnForcePlate3 .BodyModelRef.Right.Leg.Seg.Foot
 
  #define INCLUDE_ETIBIA_FORCES
  
  #define EXCLUDE_FORCEPLATE2
  #define EXCLUDE_FORCEPLATE3  

  #define STATIC_DRIVERSET 0

  // Name of the C3D file to be analysed
  AnyString TrialName = "PS_2legsquat1"; //Trialname specifies naming of output files
  AnyString C3DFile = TrialName + ".c3d"; // If named or placed differently then specify relative path and name o
  
  #ifdef INV_DYN_DRIVER_STRATEGY
  #undef INV_DYN_DRIVER_STRATEGY
  #define INV_DYN_DRIVER_STRATEGY 5
  #endif

  #ifdef USE_2DOF_SUBTALAR_JOINT
  #else
  #define USE_2DOF_SUBTALAR_JOINT
  #endif
  
 #ifndef TRIAL_SPECIFIC_FDK_INITIAL_CONDITIONS
  #define TRIAL_SPECIFIC_FDK_INITIAL_CONDITIONS
 
  // hard-coded initial values from step zero using InvDyn4 and 2-dof subtalar joint
  AnyVector TibiaFemoralFDKInitPos = {-0.003160323, -0.001086274, -0.002261643}; //x,y,z translations
  AnyVector TibiaFemoralFDKInitRot = {0.01117064, 0.06484086}; //y,x rotations
  AnyVector PatellaFemurFDKInitPos = {0.001579619, 0.005060311, -0.001196226, 0.01248995, -0.007025043};
  AnyVector PatellaTendonFDKInitPos = {0.05972163};
 #endif
  
  // ********** Time ***********
 #if MotionAndParameterOptimizationModel
  // FirstFrameOffset is the offset value from the first frame of C3D file
  AnyIntVar FirstFrameOffset = 0;
  // LastFrameOffset is the offset value from the last frame of C3D file
  AnyIntVar LastFrameOffset  = 0;
  //AnyIntVar LastFrameOffset  = 825;
  // Number of steps for the analysis but can be changed is needed
  AnyIntVar nStep = Main.ModelSetup.nStep;
 #else
  // FirstFrameOffset is the offset value from the first frame of C3D file
  AnyIntVar FirstFrameOffset = 12;
  // LastFrameOffset is the offset value from the last frame of C3D file
//  AnyIntVar LastFrameOffset  = 825; //one repetition
//  AnyIntVar LastFrameOffset  = 575; //two repetitions
  AnyIntVar LastFrameOffset  = 40; // four repetitions
  // Number of steps for the analysis but can be changed is needed
  AnyIntVar nStep = floor(Main.ModelSetup.nStep/4);
 #endif
  
  // ********** Gravity ***********
  // Gravity vector that is consistent with the laboratory setting
  AnyVector Gravity = {0.0, 0.0, -9.82}; // Z direction is normal to the ground
  
  // Link between forceplates and feet
  // #define FootOnForcePlate1 .HumanModelRef.Left.Leg.Seg.Foot
  // #define FootOnForcePlate2 .HumanModelRef.Left.Leg.Seg.Foot
  // #define FootOnForcePlate3 .HumanModelRef.Right.Leg.Seg.Foot
  // #define FootOnForcePlate4 .HumanModelRef.Left.Leg.Seg.Foot
  
  
  // HeelStrike times
  //  #define UseHeelStrikesTimes
  //  AnyVar RightHeelStrike1 = 1.102;
  //  AnyVar RightHeelStrike2 = 2.32;
  //  AnyVar LeftHeelStrike1 = 0.535;
  //  AnyVar LeftHeelStrike2 = 1.685;   
  //  AnyInt nStep_BetweenHeelStrikes = 100;
  
  
  //This is the initial position of the body it should only be touched it the kinematics does not work it first timestep
  //then these variable can be used to create a better guess, otherwise leave them unchanged
  AnyFolder InitialPositionOfBody ={
    
    // Initial Pelvis rotation. Rotation is calculated automatically if
    // the PelvisRotMat is defined.
    AnyVar PelvisRotZ = -90;
    AnyVar PelvisRotY = -10;
    AnyVar PelvisRotX = 90;
    
    AnyVar PelvisThoraxExtension = -20;
    AnyVar PelvisThoraxLateralBending=0;  
    AnyVar PelvisThoraxRotation=0;    
    
    AnyVar NeckExtension=0;     
    
    AnyFolder Right= {
      AnyVar HipFlexion                   = 0;
      AnyVar HipAbduction                 =  0;
      AnyVar HipExternalRotation          = 0;
      AnyVar KneeFlexion                  =  0;
      AnyVar AnklePlantarFlexion          =  0;
      AnyVar SubTalarEversion             =  0;
      AnyVar GlenohumeralFlexion          = 20; 
      AnyVar GlenohumeralAbduction        =  30; 
      AnyVar GlenohumeralExternalRotation =  00; 
      AnyVar ElbowFlexion                 =  90; 
      AnyVar ElbowPronation               = -60;
      AnyVar WristFlexion                 =  0;
      AnyVar WristAbduction               =  0;
    };
    
    AnyFolder Left = {
      AnyVar HipFlexion                   =  0;
      AnyVar HipAbduction                 = 0;
      AnyVar HipExternalRotation          =  0;
      AnyVar KneeFlexion                  =  0;
      AnyVar AnklePlantarFlexion          =  0;
      AnyVar SubTalarEversion             =  0;
      AnyVar GlenohumeralFlexion          =  20; 
      AnyVar GlenohumeralAbduction        =  30;
      AnyVar GlenohumeralExternalRotation =  0;
      AnyVar ElbowFlexion                 =  90; 
      AnyVar ElbowPronation               = -60;       
      AnyVar WristFlexion                 =  0;
      AnyVar WristAbduction               =  0;
    };
  };
  
  // ********** Extra Drivers ***********
  // Some Gait Labs protocols do not record sufficient markers to create a full body model.
  // In particular, markers on the head, trunk and a third marker on the foot are not standard.
  // Therefore, additioanl drivers have been added to the model fix the head, drive the trunk
  // above the pelvis and fix subtalar eversio. You can switch them on for your own C3D files:
  
  // Do you have markers on the head? If not turn on following switch:
  #ifndef HeadMarkersOnOff
  #define HeadMarkersOnOff 0
  #endif
  // Do you have markers on the Trunk? If not turn on following switch:
  #ifndef TrunkMarkersOnOff
  #define TrunkMarkersOnOff 1
  #endif
  // Do you have three markers on the Foot? If not turn on following switch:
  #ifndef ThreeFootMarkersOnOff
  #define ThreeFootMarkersOnOff 1
  #endif
  // Do you have markers on the Scapula/Clavicle? If not turn on following switch:
  #ifndef SCMarkersOnOff
  #define SCMarkersOnOff 1
  #endif
  
  #ifndef UseDetailNeckModel 
  #define UseDetailNeckModel 0
  #endif
  
};
