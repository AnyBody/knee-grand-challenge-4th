#define _READ_PP_LANDMARKS(LANDMARK_OBJECT, READER_OBJECT, SURF_FILE_OBJECT, MIRROR)\
    AnyInputXML READER_OBJECT =\
    {\
      FileName = SURF_FILE_OBJECT;\
      AnyFloat xptr0 = Obj2Num(ObjSelect("Contents.PickedPoints.point*.active", "==1", ".x_*"));\
      AnyFloat yptr0 = Obj2Num(ObjSelect("Contents.PickedPoints.point*.active", "==1", ".y_*"));\
      AnyFloat zptr0 = Obj2Num(ObjSelect("Contents.PickedPoints.point*.active", "==1", ".z_*"));\
      AnyString PointNames = Obj2Str(ObjSelect("Contents.PickedPoints.point*.active", "==1", ".name")) ;\
    };\
    LANDMARK_OBJECT = {READER_OBJECT.xptr0',READER_OBJECT.yptr0',READER_OBJECT.zptr0'}'* {{1,0,0},{0,1,0},{0,0,MIRROR}}    


#define _EXTRACT_LANDMARKS(LANDMARK_OBJECT, SURF_HANDLE, SURF_FILE_OBJECT, LANDMARK_NUMBER, MIRROR)\
    AnyIntVar LandmarkNumber##_##SURF_HANDLE = LANDMARK_NUMBER;\
    AnyFileVar SURF_HANDLE = SURF_FILE_OBJECT;\
    AnyInt NumPoints_##SURF_HANDLE = STL_Size(SURF_HANDLE, 1)[0];\
    LANDMARK_OBJECT = STL_Vertices(SURF_HANDLE, iarr(0, floor((NumPoints_##SURF_HANDLE)/LandmarkNumber##_##SURF_HANDLE), (NumPoints_##SURF_HANDLE) - 1), 1)*0.001 * {{1,0,0},{0,1,0},{0,0,MIRROR}}
    
#define _EXTRACT_LANDMARKS_PELVIS(LANDMARK_OBJECT, SURF_HANDLE, SURF_FILE_OBJECT, LANDMARK_NUMBER, MIRROR)\
    AnyIntVar LandmarkNumber##_##SURF_HANDLE = LANDMARK_NUMBER;\
    AnyFileVar SURF_HANDLE = SURF_FILE_OBJECT;\
    AnyInt NumPoints_##SURF_HANDLE = STL_Size(SURF_HANDLE, 1)[0];\
    AnyFloat LANDMARK_OBJECT = STL_Vertices(SURF_HANDLE, iarr(0, floor((NumPoints_##SURF_HANDLE)/LandmarkNumber##_##SURF_HANDLE), (NumPoints_##SURF_HANDLE) - 1), 1)*0.001 * {{1,0,0},{0,1,0},{0,0,MIRROR}}

