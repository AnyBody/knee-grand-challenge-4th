      #if BM_LEG_RIGHT != OFF

      RightThigh = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfFemurFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: femur R"
          );

        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
      RightShank = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfTibiaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: tibia R"
          );
        
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
       #ifdef _override_scaling_for_Right_Patella
       //#ifndef _override_scaling_for_Right_Patella
       AnyFunTransform3DLin ScalePatellaR = {
         //pfjoint_ptcl.PointNames = Obj2Str(&femoral_pf_vertices);
         AnyInt ap_pf_vertices = {13728,13797};
         AnyFloat ap_pf_points = STL_Vertices(Main.Morphing.SourceData.SurfFemurFileName, ap_pf_vertices, 1);  // two points around saddle peak of AP cartilage
         AnyFloat ScaleFactor = (Main.HumanModel.BodyModel.Right.Leg.Seg.Thigh.PatientNode.PatellaFemoralJointFit.Radius+0.005) / // fitted radius and cartilage assumption
           abs(vnorm(Main.HumanModel.BodyModel.Right.Leg.ModelParameters.Thigh.PatellaFemurJoint - 0.001*mean(ap_pf_points')));
           
         
         ScaleMat=eye(3)*ScaleFactor;
         Offset={0,0,0};
       };
       Main.HumanModel.Scaling.GeometricalScaling.Right.Patella.ScaleFunction.Custom = &ScalePatellaR; 
       #else       
        RightPatella = {
          AnyInt test = assert(
            eqfun(
              STL_Size(Main.Morphing.SourceData.SurfPatellaFileName, 1)[0], 
              STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPatellaRFileName, 1)[0]), 
              "Source and target files do not have the same number of vertices: patella R"
            );
          _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfPatellaFileName, Main.Morphing.Settings.LandmarkNumber, 1);
          _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfPatellaRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        };
       #endif
      #endif
      
      #if BM_LEG_LEFT != OFF

      LeftThigh = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfFemurFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfFemurLFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: femur L"
          );
        
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName, Main.Morphing.Settings.LandmarkNumber, -1);
      };
      
      LeftShank = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfTibiaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: tibia L"
          );
        
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, Main.Morphing.Settings.LandmarkNumber, -1);
      };
      
       //#ifndef _override_scaling_for_Left_Patella
       #ifdef _override_scaling_for_Left_Patella
        AnyFunTransform3DLin ScalePatellaL = {
         //pfjoint_ptcl.PointNames = Obj2Str(&femoral_pf_vertices);
         AnyInt ap_pf_vertices = {13728,13797};
         AnyFloat ap_pf_points = STL_Vertices(Main.Morphing.SourceData.SurfFemurFileName, ap_pf_vertices, 1)*{{1,0,0}, {0,1,0},{0,0,-1}} ;  // two points around saddle peak of AP cartilage
         AnyFloat ScaleFactor = (Main.HumanModel.BodyModel.Left.Leg.Seg.Thigh.PatientNode.PatellaFemoralJointFit.Radius+0.005) / // fitted radius and cartilage assumption
           abs(vnorm(Main.HumanModel.BodyModel.Left.Leg.ModelParameters.Thigh.PatellaFemurJoint - 0.001*mean(ap_pf_points')));
           
         
         ScaleMat=eye(3)*ScaleFactor;
         Offset={0,0,0};
       };
       Main.HumanModel.Scaling.GeometricalScaling.Left.Patella.ScaleFunction.Custom = &ScalePatellaL; 
       #else
        LeftPatella = {
          AnyInt test = assert(
            eqfun(
              STL_Size(Main.Morphing.SourceData.SurfPatellaFileName, 1)[0], 
              STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPatellaLFileName, 1)[0]), 
              "Source and target files do not have the same number of vertices: patella L"
            );
          _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfPatellaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
          _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfPatellaLFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        };
       
       #endif
      #endif
};

