  KneeJointPoints = (Main.HumanModel.BodyModel.Right.Leg.Seg.Thigh.Drw3.GetVertices(femoral_comp_vertices)-repmat(1, kneesurfsize, .sRel')')*.ARel;
  PFJointPoints   = (Main.HumanModel.BodyModel.Right.Leg.Seg.Thigh.Drw3.GetVertices(femoral_pf_vertices)-repmat(1, pfsurfsize, .sRel')')*.ARel;

