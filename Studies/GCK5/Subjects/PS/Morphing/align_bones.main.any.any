
Main = {

    AnyFixedRefFrame fr = {
      
      AnyDrawSurf srfFemur = {
        FileName ="femur";
      };
      AnyDrawSurf srfTibia = {
        AnyFunTransform3DLin tr = {
          ScaleMat=eye(3)*RotMat(-pi/18, z)*RotMat(pi/10, y)*RotMat(-pi/60, x);
          Offset={-7,-441,0};
        };
        FileName ="tibia";
      };
      AnyDrawSurf srfPatella= {
        AnyFunTransform3DLin tr = {
          ScaleMat=eye(3)*RotMat(pi/1.3,x);
          Offset={23,-0,10};
        };
        FileName ="patella";
      };
    
    
    };

};
