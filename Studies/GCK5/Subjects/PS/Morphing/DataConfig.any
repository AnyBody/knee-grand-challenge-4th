        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfPatellaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
      };
};

AnyFolder &LeftThigh = Main.HumanModel.BodyModel.Left.Leg.Seg.Thigh.PatientNode;
AnyFolder &LeftShank = Main.HumanModel.BodyModel.Left.Leg.Seg.Shank.PatientNode;
LeftShank = {
  AnyDrawSurf PatientShank = {
    FileName = ..SurfTibiaFileName;
    ScaleXYZ={1,1,-1}*0.001;
  };
};
LeftThigh = {
  AnyDrawSurf PatientFemur = {
    FileName = ..SurfFemurFileName;
    ScaleXYZ={1,1,-1}*0.001;
  };
  
