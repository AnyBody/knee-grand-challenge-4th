      //};
      
      
      LeftThigh = {
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, -1);
      };
      
      LeftShank = {
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
