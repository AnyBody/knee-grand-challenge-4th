// Filenames of boney surfaces used for scaling 
//AnyFile SurfPelvis = "Target/Patella_target_R.stl";

AnyFile SurfPelvisRFileName = "Target/PelvisR.stl";
AnyFile SurfFemurRFileName = "Target/FemurR.stl";
AnyFile SurfTibiaRFileName = "Target/TibiaR.stl";
AnyFile SurfPatellaRFileName = "Target/PatellaR.stl";
AnyFile SurfTalusRFileName = "Target/TalusR.stl";

AnyFile SurfPelvisLFileName = "Target/PelvisL.stl";

AnyFile SurfFemurLFileName = "Target/FemurL.stl";
AnyFile SurfTibiaLFileName = "Target/TibiaL.stl";
AnyFile SurfPatellaLFileName = "Target/PatellaL.stl";
AnyFile SurfTalusLFileName = "Target/TalusL.stl";


#define _EXTRACT_LANDMARKS(LANDMARK_OBJECT, SURF_HANDLE, SURF_FILE_OBJECT, LANDMARK_NUMBER, MIRROR)\
    AnyIntVar LandmarkNumber##_##SURF_HANDLE = LANDMARK_NUMBER;\
    AnyFileVar SURF_HANDLE = SURF_FILE_OBJECT;\
    AnyInt NumPoints_##SURF_HANDLE = STL_Size(SURF_HANDLE, 1)[0];\
    LANDMARK_OBJECT = STL_Vertices(SURF_HANDLE, iarr(0, floor((NumPoints_##SURF_HANDLE)/LandmarkNumber##_##SURF_HANDLE), (NumPoints_##SURF_HANDLE) - 1), 1)*0.001 * {{1,0,0},{0,1,0},{0,0,MIRROR}}
    
#define _EXTRACT_LANDMARKS_PELVIS(LANDMARK_OBJECT, SURF_HANDLE, SURF_FILE_OBJECT, LANDMARK_NUMBER, MIRROR)\
    AnyIntVar LandmarkNumber##_##SURF_HANDLE = LANDMARK_NUMBER;\
    AnyFileVar SURF_HANDLE = SURF_FILE_OBJECT;\
    AnyInt NumPoints_##SURF_HANDLE = STL_Size(SURF_HANDLE, 1)[0];\
    AnyFloat LANDMARK_OBJECT = STL_Vertices(SURF_HANDLE, iarr(0, floor((NumPoints_##SURF_HANDLE)/LandmarkNumber##_##SURF_HANDLE), (NumPoints_##SURF_HANDLE) - 1), 1)*0.001 * {{1,0,0},{0,1,0},{0,0,MIRROR}}
    

    
// This section is for configuring landmarks or surfaces used for scaling. We open morphing function objects and overwrite landmarks of the class template
Main.Morphing = {    
  
      Pelvis = {
        _EXTRACT_LANDMARKS_PELVIS(SourceLandmarksR, SourceSTLR, Main.Morphing.SourceData.SurfPelvisRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS_PELVIS(SourceLandmarksL, SourceSTLL, Main.Morphing.SourceData.SurfPelvisLFileName, Main.Morphing.Settings.LandmarkNumber, 1);

        _EXTRACT_LANDMARKS_PELVIS(TargetLandmarksR, TargetSTLR, Main.ModelSetup.SubjectSpecificData.SurfPelvisRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS_PELVIS(TargetLandmarksL, TargetSTLL, Main.ModelSetup.SubjectSpecificData.SurfPelvisLFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        
        AnyInt test1 = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfPelvisRFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPelvisRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: pelvis R"
          );
        AnyInt test2 = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfPelvisLFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPelvisLFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: pelvis L"
          );
        
        SourceLandmarks = arrcat(SourceLandmarksR, SourceLandmarksL);
        TargetLandmarks = arrcat(TargetLandmarksR, TargetLandmarksL);
      };
      
      
      #if BM_LEG_RIGHT != OFF

      RightThigh = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfFemurFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: femur R"
          );

        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
      RightShank = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfTibiaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: tibia R"
          );
        
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfTibiaRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
      RightPatella = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfPatellaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPatellaRFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: patella R"
          );
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfPatellaFileName, Main.Morphing.Settings.LandmarkNumber, 1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfPatellaRFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
      #endif
      
      #if BM_LEG_LEFT != OFF

      LeftThigh = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfFemurFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfFemurLFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: femur L"
          );
        
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfFemurFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfFemurLFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      
      LeftShank = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfTibiaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfTibiaLFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: tibia L"
          );
          
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfTibiaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfTibiaLFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      LeftPatella = {
        AnyInt test = assert(
          eqfun(
            STL_Size(Main.Morphing.SourceData.SurfPatellaFileName, 1)[0], 
            STL_Size(Main.ModelSetup.SubjectSpecificData.SurfPatellaLFileName, 1)[0]), 
            "Source and target files do not have the same number of vertices: patella L"
          );
        _EXTRACT_LANDMARKS(SourceLandmarks, SourceSTL, Main.Morphing.SourceData.SurfPatellaFileName, Main.Morphing.Settings.LandmarkNumber, -1);
        _EXTRACT_LANDMARKS(TargetLandmarks, TargetSTL, Main.ModelSetup.SubjectSpecificData.SurfPatellaLFileName, Main.Morphing.Settings.LandmarkNumber, 1);
      };
      #endif
};

#if BM_LEG_LEFT != OFF
AnyFolder &LeftThigh = Main.HumanModel.BodyModel.Left.Leg.Seg.Thigh.PatientNode;
AnyFolder &LeftShank = Main.HumanModel.BodyModel.Left.Leg.Seg.Shank.PatientNode;
AnyFolder &LeftPatella = Main.HumanModel.BodyModel.Left.Leg.Seg.Patella.PatientNode;
#endif

#if BM_LEG_RIGHT != OFF
AnyFolder &RightThigh = Main.HumanModel.BodyModel.Right.Leg.Seg.Thigh.PatientNode;
AnyFolder &RightShank = Main.HumanModel.BodyModel.Right.Leg.Seg.Shank.PatientNode;
AnyFolder &RightPatella = Main.HumanModel.BodyModel.Right.Leg.Seg.Patella.PatientNode;
#endif

AnyFolder &Pelvis = Main.HumanModel.BodyModel.Trunk.SegmentsLumbar.PelvisSeg.PatientNode;

Pelvis = {
  AnyDrawSurf SurfR = {
    FileName = ..SurfPelvisRFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
  AnyDrawSurf SurfL = {
    FileName = ..SurfPelvisLFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};

#if BM_LEG_LEFT != OFF

LeftShank = {
  AnyDrawSurf Surf = {
    FileName = ..SurfTibiaLFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
LeftThigh = {
  AnyDrawSurf Surf = {
    FileName = ..SurfFemurLFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
LeftPatella = {
  AnyDrawSurf Surf = {
    FileName = ..SurfPatellaLFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
#endif  
  
#if BM_LEG_RIGHT != OFF
RightShank = {
  AnyDrawSurf Surf = {
    FileName = ..SurfTibiaRFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
RightThigh = {
  AnyDrawSurf Surf = {
    FileName = ..SurfFemurRFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
RightPatella = {
  AnyDrawSurf Surf= {
    FileName = ..SurfPatellaRFileName;
    ScaleXYZ={1,1,1}*0.001;
  };
};
#endif  
