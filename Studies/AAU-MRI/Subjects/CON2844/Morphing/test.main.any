Main = {

#define SHOW_POINTCLOUD(name, points, r, g, b)  \
  AnyDrawPointCloud name = {\
    Points = .points;\
    RGB = {r, g, b};\
    Opacity = 0.5;\
    PointStyle.Size = 5;\
    Points3D = On;\
    ShowNames = Off;\
    PointToPointVectors = On;\
  }   
    
  
  #define CHECK_VERTEX_NUMBER(OBJ_NAME, FILE1, FILE2)AnyFolder OBJ_NAME = {\
         AnyFile file1 = FILE1;\
         AnyFile file2 = FILE2;\
         AnyInt test = assert(\
          eqfun(\
          STL_Size(file1, 1)[0],\
            STL_Size(file2, 1)[0]),\
            "Source and target files do not have the same number of vertices");}

  #define CHECK_VERTEX_LOCATION(OBJ_NAME, FILE1, FILE2)AnyFolder OBJ_NAME = {\
         AnyFile file1 = FILE1;\
         AnyFile file2 = FILE2;\
         AnyFloat pts = {\
           STL_Vertices(file1, .indices, 1),\
           STL_Vertices(file2, .indices, 1)};}

  
  
  AnyFixedRefFrame global = {
    
//    
    AnyDrawSurf abt_pe_R = {FileName = "ABT/PelvisR";};
//    AnyDrawSurf abt_pe_L = {FileName = "ABT/PelvisL";};
//    AnyDrawSurf abt_fe_R = {FileName = "ABT/femur";};
//    AnyDrawSurf abt_ti_R = {FileName = "ABT/tibia";};
    
    AnyDrawSurf src_pe_R = {FileName = "Source/PelvisR";};  
    AnyDrawSurf src_pe_L = {FileName = "Source/PelvisL";};
    AnyDrawSurf src_fe_R = {FileName = "Source/femurR";};
    AnyDrawSurf src_ti_R = {FileName = "Source/TibiaR";};
    
//    AnyDrawSurf trg_pe_R = {FileName = "Target/PelvisR_target";};
//    AnyDrawSurf trg_pe_L = {FileName = "Target/PelvisL_target";};
//    AnyDrawSurf trg_fe_R = {FileName = "Target/femurR_target";};
//    AnyDrawSurf trg_ti_R = {FileName = "Target/TibiaR_target";};
    
    CHECK_VERTEX_NUMBER(PelvisR, "ABT/PelvisR.stl","Source/PelvisR.stl");
    CHECK_VERTEX_NUMBER(PelvisL, "ABT/PelvisL.stl","Source/PelvisL.stl");
    CHECK_VERTEX_NUMBER(FemurR, "ABT/Femur.stl","Source/FemurR.stl");
    CHECK_VERTEX_NUMBER(TibiaR, "ABT/Tibia.stl","Source/TibiaR.stl");
    
    CHECK_VERTEX_LOCATION(PelvisRloc, "ABT/PelvisR.stl","Source/PelvisR.stl");
    AnyIntArray indices = {1, 300, 500, 1000, 2000};
    SHOW_POINTCLOUD(ptcl, PelvisRloc.pts, 1, 0, 0);
  };
};