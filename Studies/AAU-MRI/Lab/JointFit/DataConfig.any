#if BM_LEG_LEFT != OFF

Main.HumanModel.BodyModel.Left.Leg.Seg.Thigh.PatientNode.FittingData = {
  
  AnySurfSTL target_femur = {FileName = Main.ModelSetup.SubjectSpecificData.SurfFemurLFileName;};
  // these indices should be okay for TLEMSafe geometry and can be moved to AMMR, the surface object can also be in AMMR
  // something like:
  // HipJointPoints = femur.GetVertices(femoral_head_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,-1}};

  #include "FemoralHead.any"
  #include "FemoralComponentCylFitPoints.any"
  #include "FemoralComponentPatellaJointPoints.any"
  
  HipJointPoints  = target_femur.GetVertices(femoral_head_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}};
  KneeJointPoints = target_femur.GetVertices(femoral_comp_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}}; // this might actually need the implant points instead
  PFJointPoints   = target_femur.GetVertices(femoral_pf_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}};


  SHOW_POINTCLOUD(hipjoint_ptcl, HipJointPoints, 1, 0, 0);
  SHOW_POINTCLOUD(kneejoint_ptcl, KneeJointPoints, 1, 0, 0);
  SHOW_POINTCLOUD(pfjoint_ptcl, PFJointPoints, 1, 0, 1);
};
Main.HumanModel.BodyModel.Left.Leg.Seg.Shank.PatientNode = {
  ThighToShankReg.ScaleMat = eye(3);
  ThighToShankReg.Offset = zeros(3);    
};
#endif
#if BM_LEG_RIGHT != OFF

Main.HumanModel.BodyModel.Right.Leg.Seg.Thigh.PatientNode.FittingData = {
  
  AnySurfSTL target_femur = {FileName = Main.ModelSetup.SubjectSpecificData.SurfFemurRFileName;};
  // these indices should be okay for TLEMSafe geometry and can be moved to AMMR, the surface object can also be in AMMR
  // something like:
  // HipJointPoints = femur.GetVertices(femoral_head_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,-1}};

  #include "FemoralHead.any"
  #include "FemoralComponentCylFitPoints.any"
  #include "FemoralComponentPatellaJointPoints.any"
  
  HipJointPoints  = target_femur.GetVertices(femoral_head_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}};
  KneeJointPoints = target_femur.GetVertices(femoral_comp_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}}; // this might actually need the implant points instead
  PFJointPoints   = target_femur.GetVertices(femoral_pf_vertices)*0.001*{{1,0,0}, {0,1,0},{0,0,1}};


  SHOW_POINTCLOUD(hipjoint_ptcl, HipJointPoints, 1, 0, 0);
  SHOW_POINTCLOUD(kneejoint_ptcl, KneeJointPoints, 1, 0, 0);
  SHOW_POINTCLOUD(pfjoint_ptcl, PFJointPoints, 1, 0, 1);
};
