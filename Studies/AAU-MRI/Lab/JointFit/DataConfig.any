#define READ_AND_SHOW_XYZ(OBJECT, FILE, SCALE) \
  AnyInputFile OBJECT##_Reader = {\
    TOnOff = Off;\
    FileName = FILE;\
  };\
  AnyDrawPointCloud OBJECT##_Visualizer = {\
    Points = .OBJECT##_Reader.Data' * SCALE * .Mirror;\
    RGB = {1, 0, 0};\
    Opacity = 0.5;\
    PointStyle.Size = 0.005;\
    Points3D = On;\
    ShowNames = Off;\
  }   
  
#define SHOW_POINTCLOUD(name, points, r, g, b)  \
  AnyDrawPointCloud name = {\
    Points = .points;\
    RGB = {r, g, b};\
    Opacity = 0.5;\
    PointStyle.Size = 0.005;\
    Points3D = On;\
    ShowNames = Off;\
  }   
  
