#define DRAW_SURF(NAME, FILENAME, SCALE) AnyDrawSurf NAME = {FileName = FILENAME; ScaleXYZ=SCALE*{1,1,1};}
#define DRAW_LANDMARKS(NAME, FILENAME, SCALE) AnyDrawPointCloud NAME = {\
   PointStyle = {\
     Style = PointStyleSphere;// Marker style.\
     Size = 0.005;// Size of markers.\
   };\
   Points3D = On;\
  AnyFile FileName = FILENAME; \
  AnyInputXML XML = {FileName = .FileName;};\
  AnyFloat xptr0 = Obj2Num(ObjSelect("XML.Contents.PickedPoints.point*.active", "==1", ".x_*"));\
  AnyFloat yptr0 = Obj2Num(ObjSelect("XML.Contents.PickedPoints.point*.active", "==1", ".y_*"));\
  AnyFloat zptr0 = Obj2Num(ObjSelect("XML.Contents.PickedPoints.point*.active", "==1", ".z_*"));\
  Points = {xptr0',yptr0',zptr0'}';//, yptr0, zptr0};    \
  ScaleXYZ=SCALE*{1,1,1};}



