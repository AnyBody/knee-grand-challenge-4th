REF_HUMAN_BODYMODEL.Right.Leg = 
{
  Seg.Shank.PatientRefNode = 
  {
    AnyRefNode OutputNode = 
    {
      ARel = RotMat(pi, x) * RotMat(pi, y);
//      AnyDrawRefFrame Drw = {ScaleXYZ = 0.5*{1, 1, 1}; RGB = {1, 0, 0};};
    };
  };
  
  AnyFolder Measures = {
    AnyFolder Forces = {
      // We can get the forces/moments in the knee joint by finding the Contraints.Reactions object in the joint.
      // F[0] or F[1] are the same force vector but with different signs. Depends if we want the force femur inserts on tibia or opposite.
      // Here we chose [1] which is the force the femur inserts on the shank.
      AnyVec3 KneeForceInGlobal = ..Jnt.Knee.Constraints.Reaction.RefFrameOutput.F[1];
      AnyVec3 KneeMomentInGlobal = ..Jnt.Knee.Constraints.Reaction.RefFrameOutput.M[1];
      
      // We can now express the force and moments in the coordinate system we want.
      AnyVec3 KneeForceInShank = transf3D(KneeForceInGlobal, &Main.EnvironmentModel.GlobalRef, &..Seg.Shank.PatientRefNode.OutputNode);
      AnyVec3 KneeMomentInShank = transf3D(KneeMomentInGlobal, &Main.EnvironmentModel.GlobalRef, &..Seg.Shank.PatientRefNode.OutputNode);
      
      // We can now calculate two equivalent condyle compression forces which
      // generates the same total force and moment. We can imagine this as the 2 forces in the frontal
      // plane which representas the force from the tibial platau on the femoral condyles.
      // The two components are placed at somme displacement (L_medial/L_lateral) from the knee center.
      AnyVar L_medial = 0.022;
      AnyVar L_lateral = 0.022;
      
      // Here F_total is the vertical component of the force and M_total is the abbduction moment in the frontal plane.
      AnyVar F_total = KneeForceInShank[1];
      AnyVar M_total = KneeMomentInShank[0];
      
      // The relationships with the lateral/medial forces can be expressed as:
      //
      //  F_total = F_medial + F_lateral
      //  M_total = F_medial*L_medial - F_lateral*L_lateral
      //
      // From these the F_medial/F_lateral can be found:
      
      AnyFloat F_lateral = (F_total * L_medial - M_total) / (L_lateral + L_medial);
      AnyFloat F_medial = F_total - F_lateral;
      
      AnyForceMomentMeasure2 KneeForceInOutputNode = {
        AnyRefFrame &Ref = ...Seg.Shank.PatientRefNode.OutputNode;
        IncludeForces = {&...Jnt.Knee.Constraints.Reaction};
        IncludeSegments = {&...Seg.Shank};
        AnyFloat Flocal = F*Ref.Axes;
        AnyFloat Mlocal = M*Ref.Axes;
      };
    };
  };
};
Results =
{
  AnyFolder Contact = 
  {
    AnyVar F_lateral_calculated = REF_HUMAN_BODYMODEL.Right.Leg.Measures.Forces.F_lateral;
    AnyVar F_medial_calculated = REF_HUMAN_BODYMODEL.Right.Leg.Measures.Forces.F_medial;
    AnyVar F_sum_calculated = F_lateral_calculated + F_medial_calculated ;
    
    AnyVar F_lateral_measured = ..eKneeData.Fun_F_lateral(..t)[0] ;
    AnyVar F_medial_measured = ..eKneeData.Fun_F_medial(..t)[0] ;
    AnyVar F_sum_measured = F_lateral_measured + F_medial_measured ;
    
    AnyVar BW_ratio_F_lateral_calculated = F_lateral_calculated / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81);
    AnyVar BW_ratio_F_medial_calculated = F_medial_calculated / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81) ;
    AnyVar BW_ratio_F_sum_calculated = F_sum_calculated / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81) ;
    
    AnyVar BW_ratio_F_lateral_measured = F_lateral_measured / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81) ;
    AnyVar BW_ratio_F_medial_measured = F_medial_measured / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81) ;
    AnyVar BW_ratio_F_sum_measured = F_sum_measured / (REF_HUMAN_BODYMODEL.TotalBodyMass * 9.81) ; 
    
    AnyOutputFile OutputFile = 
    {
      FileName = ANYBODY_PATH_MAINFILEDIR + "\" + Main.ModelSetup.TrialSpecificData.TrialFileName + "_Results_Contact.csv";
      Values = ObjSearch(".F_*");
      Header = 
      {
        TitleSectionOnOff = Off;
        ConstSectionOnOff = Off;
        ConstSectionSaveOptionsOnOff = Off;
        VarSectionOnOff = Off;
        ColumnNamesOnOff = On;
        ShortenNamesOnOff = On;
      };
    };
    
    AnyOutputFile OutputFile2 = 
    {
      FileName = ANYBODY_PATH_MAINFILEDIR + "\" + Main.ModelSetup.TrialSpecificData.TrialFileName + "_Results_Contact_BW_Ratio.csv";
      Values = ObjSearch(".BW_*");
      Header = 
      {
        TitleSectionOnOff = Off;
        ConstSectionOnOff = Off;
        ConstSectionSaveOptionsOnOff = Off;
        VarSectionOnOff = Off;
        ColumnNamesOnOff = On;
        ShortenNamesOnOff = On;
      };
    };
    
  };//Contact
};